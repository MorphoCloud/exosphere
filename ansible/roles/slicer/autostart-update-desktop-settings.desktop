[Desktop Entry]
Type=Application
Terminal=true
Name=Update Desktop Settings
# Update Gnome Shell settings to show mounted volumes
# Allow "Slicer.desktop" to be executed
# Then touch it: the desktop (DING) reads the trusted mark only when it
# draws a file or the file changes, and it may have drawn it before this
# runs (MorphoCloud Test-Instances #592-#594: red "not allowed" emblem).
Exec=sh -c 'dconf write /org/gnome/shell/extensions/dash-to-dock/show-mounts true && gio set /home/exouser/Desktop/Slicer.desktop metadata::trusted true && touch /home/exouser/Desktop/Slicer.desktop'
Icon=
Comment=These commands are executed automatically on login
