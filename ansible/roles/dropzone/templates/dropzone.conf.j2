# Generated by ansible (roles/dropzone); edits are lost on re-provision.
# copyparty config: https://github.com/9001/copyparty#config-files

[global]
  p: {{ dropzone_port }}
  # TLS is terminated by the Exosphere proxy.
  http-only
  # up2k database: resumable, deduplicated uploads.
  e2d
  hist: {{ dropzone_hist_dir }}
  # Clients arrive via the Exosphere proxy; trust its X-Forwarded-For so the
  # brute-force ban keys on the real client, not on the proxy.
  xff-src: any
  u2sz: {{ dropzone_chunk_mib }}
  no-robots
  name: MorphoCloud

[accounts]
  exouser: {{ exouser_passphrase }}

[/]
  {{ dropzone_root }}
  accs:
    A: exouser
